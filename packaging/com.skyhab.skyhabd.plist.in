<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.skyhab.skyhabd</string>
  <key>ProgramArguments</key><array>
    <string>@SKYHABD_PATH@</string>
    <string>--inventory</string><string>@INVENTORY_PATH@</string>
    <string>--database</string><string>@DATABASE_PATH@</string>
    <string>--bind</string><string>@BIND_ADDRESS@</string>
    <string>--auth-file</string><string>@AUTH_PATH@</string>
    <string>--secrets-file</string><string>@SECRETS_PATH@</string>
    <string>--views</string><string>@VIEWS_PATH@</string>
  </array>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>@LOG_PATH@/skyhabd.log</string>
  <key>StandardErrorPath</key><string>@LOG_PATH@/skyhabd.error.log</string>
</dict></plist>
